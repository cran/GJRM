\name{print.gjrm}
\alias{print.gjrm}
\alias{print.gjrm.pcc}

\title{Print a gjrm/gjrm.pcc object}

\description{The print method for a \code{gjrm} or \code{gjrm.pcc} object.}

\usage{


\method{print}{gjrm}(x, ...)
\method{print}{gjrm.pcc}(x, ...)



}


\arguments{ 


\item{x}{\code{gjrm}/\code{gjrm.pcc} object produced by \code{gjrm()}/\code{gjrm.pcc()}.}

\item{...}{Other arguments.}

}


\details{ 

\code{print.gjrm}/\code{print.gjrm.pcc} prints out the family, model equations, total number of observations, estimated association 
coefficient, etc for the penalized or unpenalized model. 

}



